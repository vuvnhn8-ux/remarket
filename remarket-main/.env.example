# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APP_MODE: Điều khiển chế độ vận hành toàn site (AGENTS.md mục 14).
#   simulation = demo, không tạo giao dịch thật (mặc định)
#   live       = chạy luồng thanh toán thật (Stripe)
# Đây là nơi duy nhất đọc biến này để phân nhánh (lib/config/app-mode hoá tại dbStore.getAppMode).
APP_MODE="simulation"

# STRIPE_SECRET_KEY và STRIPE_WEBHOOK_SECRET + STRIPE_PUBLISHABLE_KEY:
# Chỉ cần khi APP_MODE=live. Không lộ STRIPE_SECRET_KEY/WEBHOOK_SECRET ra client bundle.
# STRIPE_PUBLISHABLE_KEY an toàn để đưa ra client.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ===== ĐĂNG KÝ + MAGIC LINK (backend Supabase + Email qua Edge Function) =====
# Luồng đăng ký email+password kèm xác thực qua MAGIC LINK (bấm link trong email).
# Kiến trúc gửi email:
#   Express server → Supabase Edge Function (send-verification-otp) → Resend → User
# RESEND_API_KEY NẰM TRONG SUPABASE SECRET (không đặt ở đây / không đặt ở Vercel).
# EMAIL_FROM cũng được đọc từ Supabase Secret của Edge Function.
#
# BẮT BUỘC cấu hình đủ (VITE_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY) để đăng ký
# chạy (provider Supabase + Edge Function → Resend). Khi THIẾU -> trả lỗi RÕ RÀNG,
# KHÔNG fallback hiển thị OTP/link cho user.
# Link email trỏ `APP_URL/verify?token=<token>` (route SPA /verify, tự đăng nhập).
#
# --- Client-safe (Vite prefix VITE_ — có thể đưa ra browser bundle) ---
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# --- Server-only (KHÔNG bao giờ lộ ra client bundle) ---
# SUPABASE_SERVICE_ROLE_KEY: dùng để tạo user + xác thực lời gọi Edge Function.
SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_FUNCTION_URL (tuỳ chọn): URL gốc các Edge Function. Mặc định tự suy
# ra từ VITE_SUPABASE_URL (https://<project-ref>.supabase.co/functions/v1).
SUPABASE_FUNCTION_URL=""
# DEV_EXPOSE_VERIFY_LINK (DEVELOPER ONLY, mặc định tắt): khi =true, API register
# trả thêm field `devVerifyLink` để test/curl luồng mà không cần đọc email thật.
# UI KHÔNG hiển thị field này — đây KHÔNG phải fallback cho user. Tắt ở production.
DEV_EXPOSE_VERIFY_LINK=""

